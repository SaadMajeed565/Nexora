# Nexora backend environment — copy to .env and fill in
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/nexora
JWT_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REDIS_URL=redis://localhost:6379

# Tool credentials (self-hosted catalog in backend/src/tools/ — one per service,
# from that service's own developer account; stored in the secrets store in Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TELEGRAM_BOT_TOKEN=
